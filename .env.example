# Copy this file to `.env` (or `.env.local`) and fill in your Supabase project values.
# Both values are PUBLIC client values (safe to ship to the browser).
# NEVER put the service_role key here — it bypasses all security rules.
#
# Leave them empty and Study Paws still works in solo mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
